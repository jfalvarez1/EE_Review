VREF vref 0 DC 2.5
VIN vin 0 DC 1.25
Vb3 b3_ctrl 0 DC 5
Vb2 b2_ctrl 0 DC 0
Vb1 b1_ctrl 0 DC 0
Vb0 b0_ctrl 0 DC 0
XS3 vref 0 n3 b3_ctrl SPDT_SWITCH
XS2 vref 0 n2 b2_ctrl SPDT_SWITCH
XS1 vref 0 n1 b1_ctrl SPDT_SWITCH
XS0 vref 0 n0 b0_ctrl SPDT_SWITCH
C3 n3 vcm 8.08p
C2 n2 vcm 4p
C1 n1 vcm 2p
C0 n0 vcm 1p
CT vcm 0 1p
XUCMP vcm vin cmp OPAMP
