# Temporary files
nul
*.log
server-*.log

# Claude workspace
.claude/

# Python cache
__pycache__/
*.pyc
*.pyo

# Editor/IDE
.vscode/
.idea/
*.swp
*~

# OS specific
.DS_Store
Thumbs.db

# Session/development files (keep for reference)
# Uncomment if you want to exclude them:
# session_context.md
# SESSION_PROGRESS_SAVE.md
# CLAUDE_SESSION_README.md

# Third-party reference PDFs (The Art of Electronics, Analog Pocket Reference,
# TI Analog Engineer's Circuit Cookbook). These are copyrighted works and must
# not be redistributed, so they are kept locally and never committed.
# They were removed from git history on 2026-08-31; nothing in the application
# reads them at runtime.
split_pdfs/
*.pdf

# Local screenshot contact sheet — generated, not part of the project.
_screenshots/

# The single-file offline build. ~13 MB and rebuilt whenever any lesson
# changes, so committing it would outgrow the entire source within a few dozen
# edits. It is built by .github/workflows/release.yml and attached to the
# GitHub Release instead. Build it locally with:
#     node tools/build-standalone.js
dist/

# Vendored MathJax for the offline build. Fetched at build time rather than
# committed; 2 MB of third-party minified code does not belong in the history.
assets/vendor/
